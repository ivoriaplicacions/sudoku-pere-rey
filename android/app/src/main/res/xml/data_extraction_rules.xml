<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31). The game keeps its data in the WebView's local storage under
  app_webview, and a second copy in SharedPreferences (CapacitorStorage.xml, written
  through @capacitor/preferences; see src/services/nativeStore.ts). Both are carried
  over, so a restore works whichever of the two survived.

  The cached pack ownership travels too, but it is not authoritative:
  syncPurchasesFromStore() rebuilds it from the store receipts on every launch, so a
  restore onto a device without the entitlement corrects itself.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="root" path="app_webview" />
    <include domain="sharedpref" path="CapacitorStorage.xml" />
  </cloud-backup>
  <device-transfer>
    <include domain="root" path="app_webview" />
    <include domain="sharedpref" path="CapacitorStorage.xml" />
  </device-transfer>
</data-extraction-rules>
